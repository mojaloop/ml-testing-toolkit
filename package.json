{
  "name": "ml-testing-toolkit",
  "description": "Testing Toolkit for Mojaloop implementations",
  "version": "18.19.2",
  "license": "Apache-2.0",
  "author": "Vijaya Kumar Guthi, ModusBox Inc. ",
  "contributors": [
    "Georgi Logodazhki <georgi.logodazhki@modusbox.com>",
    "Sam Kummary <sam@modusbox.com>",
    "Steven Oderayi <steven.oderayi@modusbox.com>",
    "Vijay Kumar <vijaya.guthi@modusbox.com>",
    "Shashikant Hirugade <shashi.mojaloop@gmail.com>"
  ],
  "engines": {
    "node": ">=22.x"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mojaloop/ml-testing-toolkit.git"
  },
  "bugs": "https://github.com/mojaloop/ml-testing-toolkit/issues",
  "config": {},
  "bin": "src/index.js",
  "standard": {
    "env": [
      "jest"
    ],
    "ignore": [
      "test",
      "postman",
      "documents",
      "spec_files",
      "simulator"
    ]
  },
  "pre-commit": [
    "lint",
    "dep:check",
    "audit:check",
    "test"
  ],
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "standard": "standard",
    "standard:fix": "standard --fix",
    "dev": "nodemon src/index.js",
    "test": "npm run test:unit",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch '**/test/unit/**/*.test.js'",
    "test:int": "NODE_OPTIONS=--experimental-vm-modules jest --reporters=default --reporters=jest-junit --testMatch '**/test/integration/**/*.test.js'",
    "test:integration": "echo 'No integration tests defined'",
    "test:func": "cd test/func && docker-compose up --exit-code-from=test-service",
    "test:functional": "npm run docker:build && npm run test:func && npm run docker:down",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --coverageThreshold='{}' --testMatch '**/test/unit/**/*.test.js'",
    "test:coverage-check": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --testMatch '**/test/unit/**/*.test.js'",
    "test:junit": "NODE_OPTIONS=--experimental-vm-modules jest --reporters=default --reporters=jest-junit --testMatch '**/test/unit/**/*.test.js'",
    "test:xunit": "npm run test:unit > ./test/results/xunit.xml",
    "lint": "npm run standard",
    "lint:fix": "npm run standard:fix",
    "docker:build": "docker build --build-arg NODE_VERSION=\"$(cat .nvmrc)-alpine\" -t mojaloop/ml-testing-toolkit:local .",
    "docker:up": "docker-compose -f docker-compose.yml up -d",
    "docker:stop": "docker-compose -f docker-compose.yml stop",
    "docker:rm": "docker-compose -f docker-compose.yml rm -f -v",
    "docker:down": "docker-compose -f docker-compose.yml down -v",
    "docker:clean": "docker-compose -f docker-compose.yml down --rmi local",
    "audit:check": "npx audit-ci --config ./audit-ci.jsonc",
    "audit:fix": "npm audit fix",
    "dep:check": "npx ncu -e 2",
    "dep:update": "npx ncu -u",
    "release": "npx standard-version --no-verify --releaseCommitMessageFormat 'chore(release): {{currentTag}} [skip ci]'",
    "snapshot": "npx standard-version --no-verify --skip.changelog --prerelease snapshot --releaseCommitMessageFormat 'chore(snapshot): {{currentTag}}'",
    "genexec": "pkg -t node8-win ."
  },
  "dependencies": {
    "@elastic/elasticsearch": "9.5.1",
    "@hapi/basic": "7.0.2",
    "@hapi/boom": "10.0.1",
    "@hapi/good": "9.0.1",
    "@hapi/hapi": "21.4.11",
    "@hapi/inert": "7.1.3",
    "@hapi/vision": "7.0.3",
    "@mojaloop/central-services-logger": "11.10.7",
    "@mojaloop/central-services-metrics": "12.8.9",
    "@mojaloop/ml-schema-transformer-lib": "2.10.2",
    "@mojaloop/ml-testing-toolkit-shared-lib": "14.3.5",
    "@mojaloop/sdk-standard-components": "19.19.3",
    "@now-ims/hapi-now-auth": "2.1.0",
    "@types/socket.io": "3.0.2",
    "adm-zip": "0.6.1",
    "ajv-formats": "3.0.1",
    "atob": "2.1.2",
    "axios": "1.20.0",
    "chai": "6.3.0",
    "connection-string": "^5.0.0",
    "cookie-parser": "1.4.7",
    "cookies": "0.9.2",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "express": "5.3.0",
    "express-validator": "7.3.2",
    "handlebars": "4.7.10",
    "hapi-auth-bearer-token": "8.0.0",
    "hapi-openapi": "3.0.0",
    "hapi-swagger": "17.3.2",
    "ilp-packet": "3.1.3",
    "js-yaml": "5.5.0",
    "json-refs": "3.0.15",
    "json-rules-engine": "7.3.1",
    "jsonwebtoken": "9.0.3",
    "lodash": "4.18.1",
    "mongoose": "9.11.3",
    "multer": "2.5.0",
    "mustache": "4.2.0",
    "mv": "2.1.1",
    "node-dir": "0.1.17",
    "node-strings": "1.0.2",
    "openapi-backend": "5.22.0",
    "parse-strings-in-object": "1.6.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "path": "0.12.7",
    "postman-collection": "5.3.1",
    "postman-sandbox": "6.9.0",
    "rc": "1.2.8",
    "request-to-curl": "0.1.6",
    "selectn": "1.3.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "ulidx": "2.4.1",
    "uuid": "14.0.3",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "audit-ci": "7.1.0",
    "axios-mock-adapter": "2.1.0",
    "get-port": "7.2.0",
    "jest": "30.5.2",
    "jest-junit": "17.0.0",
    "nodemon": "3.1.14",
    "npm-check-updates": "23.1.1",
    "nyc": "18.0.0",
    "parse-strings-in-object": "1.6.0",
    "pre-commit": "2.0.0",
    "proxyquire": "2.1.3",
    "replace": "1.2.2",
    "sinon": "22.1.0",
    "standard": "17.1.2",
    "standard-version": "9.5.0",
    "supertest": "7.3.1",
    "tap-xunit": "2.4.1"
  },
  "imports": {
    "#src/*": "./src/*.js",
    "#test/*": "./test/*.js"
  },
  "generator-swaggerize": {
    "version": "4.1.0"
  },
  "pkg": {
    "scripts": "src/**/custom-functions/*.js",
    "options": [
      "experimental-modules"
    ]
  },
  "standard-version": {
    "scripts": {
      "postchangelog": "replace '\\[mojaloop/#(\\d+)\\]\\(https://github.com/mojaloop/(.*)/issues/(\\d+)\\)' '[mojaloop/#$1](https://github.com/mojaloop/project/issues/$1)' CHANGELOG.md"
    }
  },
  "overrides": {
    "axios": "1.20.0",
    "form-data": "4.0.6",
    "npm-check-updates": {
      "rimraf": "4.1.2"
    },
    "lodash": "4.18.1",
    "lodash-es": "4.18.1",
