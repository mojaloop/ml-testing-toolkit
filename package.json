    "@hapi/content": "6.0.2",
    "browserslist": "4.28.7",
    "engine.io": "6.6.11",
    "fast-uri": "3.1.8",
    "linkify-it": "5.0.2",
    "path-to-regexp": "8.4.0",
    "socket.io-parser": "4.2.7",
    "nanoid": "3.3.18",
    "mysql2": "3.24.4",
    "@hapi/wreck": "18.1.2",
    "@opentelemetry/core": "2.8.0",
    "yaml": "2.9.1",
    "baseline-browser-mapping": "2.11.0",
    "follow-redirects": "1.16.1",
    "@babel/core": "7.29.6",
    "serialize-error": "8.1.0",
    "js-yaml@4": "4.3.2",
    "js-yaml@3": "3.15.2",
    "ws@8": "8.22.0",
    "ajv@6": "6.15.0",
